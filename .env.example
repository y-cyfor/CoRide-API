# CoRide-API 环境变量配置
# 复制此文件为 .env 并修改对应值

# 管理员账号（首次启动时生效，已存在则跳过）
CORIDE_ADMIN_USERNAME=admin
CORIDE_ADMIN_PASSWORD=admin123

# JWT 签名密钥（务必使用随机字符串，生产环境不要使用默认值）
CORIDE_JWT_SECRET=change-me-to-a-random-secret

# 渠道 API Key 加密密钥（AES-256-GCM）。
# - 留空则回退到 CORIDE_JWT_SECRET（兼容旧版本）。
# - 支持密钥轮换：新密钥放最前，旧密钥保留在后面，解密时会依次尝试。
#   例：CORIDE_ENCRYPTION_SECRETS=new-secret,old-secret
# - 更换此值后，旧的渠道 Key 将无法解密（除非保留旧密钥），请先备份数据库。
# CORIDE_ENCRYPTION_SECRETS=

# 日志级别: trace / debug / info / warn / error
CORIDE_LOG_LEVEL=info

# 服务端口（默认 8000）
# CORIDE_PORT=8000

# 数据库路径（Docker 部署时映射到 volume）
# CORIDE_DB_PATH=/app/data/coride.db

# 可信反向代理地址（逗号分隔）。只有来自这些地址的请求才会读取 X-Real-IP，
# 避免客户端伪造 IP 绕过黑名单/白名单。
# CORIDE_TRUSTED_PROXIES=127.0.0.1,::1

# 是否启用渠道健康检查（true / false，默认 true）
# 关闭后不会自动禁用/恢复渠道，适合手动维护的场景。
# CORIDE_HEALTH_CHECK_ENABLED=true
